# ── Dependencies ─────────────────────────────
node_modules/
.pnpm-store/

# ── Build output / caches ────────────────────
dist/
dist-ssr/
build/
coverage/
.vite/
*.tsbuildinfo
.eslintcache

# ── Environment & secrets (never commit) ─────
.env
.env.*
!.env.example
*.local
*.pem
*.key

# ── Logs ─────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editors / OS ─────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ── Python (scripts/) ────────────────────────
__pycache__/
*.py[cod]
.venv/

# ── Deploy tooling ───────────────────────────
.vercel/
.netlify/

# ── 3D sources ───────────────────────────────
# Original Tripo exports are ~65 MB each. Only the optimized
# web versions in public/models/ (~1 MB each) are versioned.
*.glb
*.gltf
*.fbx
*.obj
*.blend
!public/models/*.glb
