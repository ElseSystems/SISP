{
  "name": "sisp",
  "version": "1.0.0",
  "private": true,
  "description": "SISP – Health & Prevention System: offline-first health self-assessment and emergency guidance for astronauts (NASA Space Apps Challenge).",
  "license": "MIT",
  "author": "Samuel Nogueira",
  "keywords": [
    "nasa",
    "space-apps",
    "astronaut",
    "health-monitoring",
    "react",
    "c11",
    "webassembly",
    "three.js"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "check": "npm run lint && npm run test:core && npm run test:storage && npm run build",
    "data": "python3 scripts/fetch_nasa_data.py",
    "build:core": "bash scripts/build-core-wasm.sh",
    "test:core": "node scripts/core-parity.ts",
    "fixtures:core": "node scripts/core-parity.ts --write",
    "core:native": "cmake -S core -B core/build -DSISP_WERROR=ON && cmake --build core/build && ctest --test-dir core/build --output-on-failure",
    "test:storage": "node scripts/storage-test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
